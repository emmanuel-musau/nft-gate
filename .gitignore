# Dependencies
node_modules/

# Build outputs
dist/
.turbo/
**/build/

# Aiken build artifacts (the SDK vendors a copy at packages/sdk/src/plutus.json)
**/plutus.json
!packages/sdk/src/plutus.json

# Per-wallet record of a live gate deployment (tx hashes, not secrets) — written
# at runtime and only valid for the wallet that produced it. Consumers
# self-deploy (Model A), so a committed one would name a gate nobody else owns.
examples/*/deployment.*.json

# Environment — never commit real secrets
.env
.env.*.local

# Editor / OS
.DS_Store
*.log
