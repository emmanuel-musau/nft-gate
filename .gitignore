# Dependencies
node_modules/

# Build outputs
dist/
.turbo/
**/build/

# Aiken build artifacts (the SDK vendors a copy at packages/sdk/src/plutus.json)
**/plutus.json
!packages/sdk/src/plutus.json

# Per-wallet record of a live gate deployment (tx hashes, not secrets) — written
# by the demo at runtime and only valid for the wallet that produced it.
examples/demo-vault/deployment.*.json

# Environment — never commit real secrets
.env
.env.*.local

# Editor / OS
.DS_Store
*.log
