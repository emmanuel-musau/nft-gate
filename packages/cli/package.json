{
  "name": "@nft-gate/cli",
  "version": "0.0.0",
  "description": "CLI for NFT Gate: instantiate, deploy, and test gates from the terminal",
  "license": "MIT",
  "type": "module",
  "bin": {
    "nft-gate": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/index.js",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@nft-gate/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.8.3"
  }
}
