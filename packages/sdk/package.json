{
  "name": "@nft-gate/sdk",
  "version": "0.0.0",
  "description": "TypeScript SDK for NFT Gate: bring-your-own-token access control for Cardano DApps",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/plutus.json dist/plutus.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@evolution-sdk/evolution": "^0.5.11",
    "effect": "^3.16.12"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
